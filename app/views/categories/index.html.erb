<h1 class="h2 mb-4">Kategoriler</h1>

<div class="row g-3">
  <% @categories.each do |category| %>
    <div class="col-md-4">
      <%= link_to category_path(category), class: "card text-decoration-none text-dark border-0 shadow-sm h-100" do %>
        <div class="card-body">
          <h2 class="h5 mb-1"><%= category.name %></h2>
          <p class="text-muted small mb-0"><%= category.products.active.count %> ürün</p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
