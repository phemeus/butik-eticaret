<%= form_with model: product,
      url: product.persisted? ? admin_product_path(product.id) : admin_products_path,
      method: product.persisted? ? :patch : :post,
      html: { multipart: true } do |f| %>
  <% if product.errors.any? %>
    <div class="alert alert-danger border-0"><%= product.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Ürün Adı", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <%= f.label :slug, class: "form-label" %>
    <%= f.text_field :slug, class: "form-control", placeholder: "Boş bırakılırsa otomatik oluşur" %>
  </div>
  <div class="mb-3">
    <%= f.label :description, "Açıklama", class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 5 %>
  </div>
  <div class="row g-3">
    <div class="col-sm-6">
      <%= f.label :price, "Fiyat (TL)", class: "form-label" %>
      <%= f.number_field :price, step: 0.01, min: 0, class: "form-control", required: true %>
    </div>
    <div class="col-sm-6">
      <%= f.label :category_id, "Kategori", class: "form-label" %>
      <%= f.collection_select :category_id, categories, :id, :name, {}, class: "form-select", required: true %>
    </div>
  </div>
  <div class="admin-card mb-4">
    <div class="admin-card__header">Ana Sayfa Görünürlüğü</div>
    <div class="admin-card__body">
      <div class="row g-3">
        <div class="col-md-6">
          <div class="form-check form-switch mb-2">
            <%= f.check_box :featured, class: "form-check-input", role: "switch" %>
            <%= f.label :featured, "Öne çıkar", class: "form-check-label fw-medium" %>
          </div>
          <%= f.label :featured_until, "Öne çıkarma bitiş (opsiyonel)", class: "form-label" %>
          <%= f.datetime_local_field :featured_until, class: "form-control" %>
          <div class="form-text">Boş bırakılırsan süresiz öne çıkar.</div>
        </div>
        <div class="col-md-6">
          <div class="form-check form-switch mb-2">
            <%= f.check_box :new_arrival, class: "form-check-input", role: "switch" %>
            <%= f.label :new_arrival, "Yeni gelen", class: "form-check-label fw-medium" %>
          </div>
          <%= f.label :new_arrival_until, "Yeni etiketi bitiş (opsiyonel)", class: "form-label" %>
          <%= f.datetime_local_field :new_arrival_until, class: "form-control" %>
          <div class="form-text">Boş bırakılırsan süresiz yeni sayılır.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="form-check form-switch my-3">
    <%= f.check_box :active, class: "form-check-input", role: "switch" %>
    <%= f.label :active, "Mağazada yayında", class: "form-check-label" %>
  </div>
  <div class="mb-4">
    <%= f.label :images, "Görseller", class: "form-label" %>
    <%= f.file_field :images, multiple: true, class: "form-control" %>
    <div class="form-text">Birden fazla görsel seçebilirsiniz.</div>
  </div>

  <%= render "admin/shared/seo_fields", form: f %>

  <div class="d-flex gap-2">
    <%= f.submit "Kaydet", class: "btn btn-admin-primary" %>
    <%= link_to "İptal", admin_products_path, class: "btn btn-admin-ghost" %>
  </div>
<% end %>
