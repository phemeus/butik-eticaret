<header class="admin-topbar">
  <div class="d-flex align-items-center gap-3">
    <button type="button" class="admin-mobile-toggle" id="adminSidebarToggle" aria-label="Menüyü aç" data-admin-target="toggle">
      <i class="bi bi-list" aria-hidden="true"></i>
    </button>
    <p class="admin-topbar__title mb-0"><%= content_for?(:title) ? yield(:title) : "Yönetim Paneli" %></p>
  </div>

  <div class="d-flex align-items-center gap-3">
    <% if Current.user %>
      <span class="admin-topbar__user d-none d-sm-inline"><%= Current.user.full_name.presence || Current.user.email_address %></span>
    <% end %>
    <%= button_to session_path, method: :delete, class: "btn btn-admin-ghost btn-sm" do %>
      <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>
      Çıkış
    <% end %>
  </div>
</header>
