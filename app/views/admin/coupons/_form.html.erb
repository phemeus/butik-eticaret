<%= form_with model: [:admin, coupon], url: coupon.persisted? ? admin_coupon_path(coupon) : admin_coupons_path do |f| %>
  <% if coupon.errors.any? %>
    <div class="alert alert-danger border-0"><%= coupon.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="admin-card mb-4">
        <div class="admin-card__header">Kupon Bilgileri</div>
        <div class="admin-card__body">
          <div class="mb-3">
            <%= f.label :code, "Kod", class: "form-label" %>
            <%= f.text_field :code, class: "form-control text-uppercase", required: true, placeholder: "YAZ10" %>
          </div>
          <div class="mb-3">
            <%= f.label :discount_type, "İndirim tipi", class: "form-label" %>
            <%= f.select :discount_type, Coupon.discount_types.keys.map { |k| [ k == "percent" ? "Yüzde (%)" : "Sabit tutar (TL)", k ] }, {}, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :discount_value, "Yüzde indirim", class: "form-label" %>
            <%= f.number_field :discount_value, min: 1, max: 100, class: "form-control" %>
            <div class="form-text">Yüzde tipinde kullanılır.</div>
          </div>
          <div class="mb-3">
            <%= f.label :fixed_amount, "Sabit indirim (TL)", class: "form-label" %>
            <%= f.number_field :fixed_amount, step: 0.01, min: 0, class: "form-control" %>
            <div class="form-text">Sabit tutar tipinde kullanılır.</div>
          </div>
          <div class="mb-3">
            <%= f.label :minimum_order, "Minimum sepet (TL)", class: "form-label" %>
            <%= f.number_field :minimum_order, step: 0.01, min: 0, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :max_uses, "Maks. kullanım (opsiyonel)", class: "form-label" %>
            <%= f.number_field :max_uses, min: 1, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :expires_at, "Bitiş tarihi (opsiyonel)", class: "form-label" %>
            <%= f.datetime_local_field :expires_at, class: "form-control" %>
          </div>
          <div class="form-check form-switch">
            <%= f.check_box :active, class: "form-check-input", role: "switch" %>
            <%= f.label :active, "Aktif", class: "form-check-label" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Kaydet", class: "btn btn-admin-primary" %>
    <%= link_to "İptal", admin_coupons_path, class: "btn btn-admin-ghost" %>
  </div>
<% end %>
