<%= form_with model: category,
      url: category.persisted? ? admin_category_path(category.id) : admin_categories_path,
      method: category.persisted? ? :patch : :post,
      html: { multipart: true } do |f| %>
  <% if category.errors.any? %>
    <div class="alert alert-danger border-0"><%= category.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :name, "Kategori Adı", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="mb-3">
    <%= f.label :slug, class: "form-label" %>
    <%= f.text_field :slug, class: "form-control", placeholder: "Boş bırakılırsa otomatik oluşur" %>
  </div>
  <div class="mb-4">
    <%= f.label :image, "Kategori Görseli", class: "form-label" %>
    <%= f.file_field :image, class: "form-control", accept: "image/*" %>
    <% if category.image.attached? %>
      <div class="mt-3">
        <%= attachment_image_tag category.image, resize: [120, 150], alt: category.name, class: "rounded border" %>
      </div>
    <% end %>
    <div class="form-text">Ana sayfa kategori bloklarında kullanılır.</div>
  </div>

  <%= render "admin/shared/seo_fields", form: f %>

  <div class="d-flex gap-2">
    <%= f.submit "Kaydet", class: "btn btn-admin-primary" %>
    <%= link_to "İptal", admin_categories_path, class: "btn btn-admin-ghost" %>
  </div>
<% end %>
