<div class="d-flex justify-content-between align-items-end mb-4">
  <div>
    <h1 class="h2 mb-1">Koleksiyon</h1>
    <p class="text-muted mb-0">Butik parçalarımızı keşfedin</p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-8">
    <%= form_with url: products_path, method: :get, class: "d-flex gap-2" do %>
      <%= select_tag :category_id,
            options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
            include_blank: "Tüm kategoriler",
            class: "form-select" %>
      <%= submit_tag "Filtrele", class: "btn btn-outline-dark" %>
    <% end %>
  </div>
</div>

<div class="row g-4">
  <% @products.each do |product| %>
    <div class="col-md-4">
      <div class="card product-card h-100 border-0 shadow-sm">
        <% if product.images.attached? %>
          <%= link_to product_path(product) do %>
            <%= attachment_image_tag product.images.first, resize: [400, 500], class: "card-img-top", alt: product.name %>
          <% end %>
        <% else %>
          <div class="bg-secondary-subtle d-flex align-items-center justify-content-center" style="height:280px">Görsel yok</div>
        <% end %>
        <div class="card-body">
          <p class="text-muted small mb-1"><%= product.category.name %></p>
          <h2 class="h5 card-title"><%= link_to product.name, product_path(product), class: "text-decoration-none text-dark" %></h2>
          <p class="fw-semibold mb-0"><%= format_price(product.display_price_cents) %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @products.empty? %>
  <p class="text-muted">Henüz ürün bulunmuyor.</p>
<% end %>
