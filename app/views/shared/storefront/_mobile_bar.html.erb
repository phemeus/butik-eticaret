<nav class="sf-mobile-bar d-lg-none" aria-label="Mobil menü">
  <%= link_to root_path, class: "sf-mobile-bar__item #{'is-active' if params[:controller] == 'home'}", aria: { label: "Ana sayfa", current: params[:controller] == 'home' ? 'page' : false } do %>
    <i class="bi bi-house" aria-hidden="true"></i>
    <span>Ana Sayfa</span>
  <% end %>
  <%= link_to categories_path, class: "sf-mobile-bar__item #{'is-active' if params[:controller] == 'categories'}", aria: { label: "Kategoriler" } do %>
    <i class="bi bi-grid" aria-hidden="true"></i>
    <span>Kategoriler</span>
  <% end %>
  <%= link_to cart_path, class: "sf-mobile-bar__item #{'is-active' if params[:controller] == 'carts'}", aria: { label: "Sepet" } do %>
    <i class="bi bi-bag" aria-hidden="true"></i>
    <span>Sepet</span>
    <% if authenticated? && current_cart&.item_count.to_i > 0 %>
      <span class="sf-header__badge"><%= current_cart.item_count %></span>
    <% end %>
  <% end %>
  <%= link_to (authenticated? ? orders_path : new_session_path), class: "sf-mobile-bar__item", aria: { label: authenticated? ? "Hesabım" : "Giriş" } do %>
    <i class="bi bi-person" aria-hidden="true"></i>
    <span><%= authenticated? ? "Hesabım" : "Giriş" %></span>
  <% end %>
</nav>
