<% if flash.any? %>
  <div class="container-store pt-3" role="status" aria-live="polite">
    <% flash.each do |type, message| %>
      <div class="alert alert-<%= type == "notice" ? "success" : "danger" %> alert-dismissible fade show border-0 shadow-sm" role="alert">
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
      </div>
    <% end %>
  </div>
<% end %>
