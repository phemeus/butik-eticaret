<h1 class="h2 mb-4">Adreslerim</h1>

<div class="mb-3">
  <%= link_to "Yeni Adres", new_address_path, class: "btn btn-dark" %>
</div>

<div class="row g-3">
  <% @addresses.each do |address| %>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h2 class="h6"><%= address.title %></h2>
          <p class="mb-2 small">
            <%= address.full_name %><br>
            <%= address.phone %><br>
            <%= address.address_line %><br>
            <%= address.district %> / <%= address.city %>
          </p>
          <div class="d-flex gap-2">
            <%= link_to "Düzenle", edit_address_path(address), class: "btn btn-sm btn-outline-dark" %>
            <%= button_to "Sil", address_path(address), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Emin misiniz?" } } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
