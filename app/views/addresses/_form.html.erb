<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <%= form_with model: address do |f| %>
          <% if address.errors.any? %>
            <div class="alert alert-danger"><%= address.errors.full_messages.to_sentence %></div>
          <% end %>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :title, "Adres Başlığı", class: "form-label" %>
              <%= f.text_field :title, class: "form-control", placeholder: "Ev, İş..." %>
            </div>
            <div class="col-md-6">
              <%= f.label :full_name, "Ad Soyad", class: "form-label" %>
              <%= f.text_field :full_name, class: "form-control" %>
            </div>
            <div class="col-md-6">
              <%= f.label :phone, "Telefon", class: "form-label" %>
              <%= f.text_field :phone, class: "form-control" %>
            </div>
            <div class="col-md-6">
              <%= f.label :city, "İl", class: "form-label" %>
              <%= f.text_field :city, class: "form-control" %>
            </div>
            <div class="col-md-6">
              <%= f.label :district, "İlçe", class: "form-label" %>
              <%= f.text_field :district, class: "form-control" %>
            </div>
            <div class="col-md-6">
              <%= f.label :postal_code, "Posta Kodu", class: "form-label" %>
              <%= f.text_field :postal_code, class: "form-control" %>
            </div>
            <div class="col-12">
              <%= f.label :address_line, "Adres", class: "form-label" %>
              <%= f.text_area :address_line, class: "form-control", rows: 3 %>
            </div>
          </div>
          <div class="mt-4">
            <%= f.submit "Kaydet", class: "btn btn-dark" %>
            <%= link_to "İptal", addresses_path, class: "btn btn-link" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
