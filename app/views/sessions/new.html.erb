<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-4">Giriş Yap</h1>
        <%= form_with url: session_path, method: :post do |f| %>
          <div class="mb-3">
            <%= label_tag :email_address, "E-posta", class: "form-label" %>
            <%= email_field_tag :email_address, params[:email_address], class: "form-control", required: true %>
          </div>
          <div class="mb-3">
            <%= label_tag :password, "Şifre", class: "form-label" %>
            <%= password_field_tag :password, nil, class: "form-control", required: true %>
          </div>
          <%= submit_tag "Giriş Yap", class: "btn btn-dark w-100" %>
        <% end %>
        <p class="mt-3 mb-0 small text-muted">Hesabınız yok mu? <%= link_to "Kayıt olun", new_registration_path %></p>
      </div>
    </div>
  </div>
</div>
