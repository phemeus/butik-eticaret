<tr id="<%= dom_id(cart_item) %>">
  <td><%= cart_item.product_variant.product.name %></td>
  <td><%= cart_item.product_variant.label %></td>
  <td><%= format_price(cart_item.product_variant.effective_price_cents) %></td>
  <td>
    <%= form_with model: cart_item, url: cart_cart_item_path(cart_item), method: :patch, data: { turbo: true } do |f| %>
      <%= f.number_field :quantity, min: 1, class: "form-control form-control-sm", style: "width:80px", onchange: "this.form.requestSubmit()" %>
    <% end %>
  </td>
  <td><%= format_price(cart_item.line_total_cents) %></td>
  <td>
    <%= button_to "Sil", cart_cart_item_path(cart_item), method: :delete, class: "btn btn-sm btn-outline-danger" %>
  </td>
</tr>
