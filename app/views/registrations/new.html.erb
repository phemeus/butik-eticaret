<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-4">Kayıt Ol</h1>
        <%= form_with model: @user, url: registration_path do |f| %>
          <% if @user.errors.any? %>
            <div class="alert alert-danger"><%= @user.errors.full_messages.to_sentence %></div>
          <% end %>
          <div class="mb-3">
            <%= f.label :full_name, "Ad Soyad", class: "form-label" %>
            <%= f.text_field :full_name, class: "form-control" %>
          </div>
          <div class="mb-3">
            <%= f.label :email_address, "E-posta", class: "form-label" %>
            <%= f.email_field :email_address, class: "form-control", required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :password, "Şifre", class: "form-label" %>
            <%= f.password_field :password, class: "form-control", required: true %>
          </div>
          <div class="mb-3">
            <%= f.label :password_confirmation, "Şifre Tekrar", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-control", required: true %>
          </div>
          <%= f.submit "Kayıt Ol", class: "btn btn-dark w-100" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
